import json
# Import the engine class from your file
from reactivity_engine import ReactivityEngine

def print_engine_results(smiles_A, smiles_B=None, temperature="room", bulk="standard"):
    """Wrapper function to format and print the backend output nicely."""
    engine = ReactivityEngine()

    # Pack conditions matching the expected input format
    conditions = {
        "temperature": temperature,
        "reagent_bulk": bulk
    }

    # Run the engine
    output = engine.process_mixture(smiles_A, smiles_B, conditions)

    # Format the dictionary output into a clean, readable string (pretty printing)
    formatted_json = json.dumps(output, indent=4)

    print("=" * 60)
    print(f"INPUTS:\n  Reactant A: {smiles_A}\n  Reactant B: {smiles_B or 'None'}")
    print(f"  Conditions: Temp={temperature}, Bulk={bulk}")
    print("=" * 60)
    print("ENGINE OUTPUT:")
    print(formatted_json)
    print("=" * 60 + "\n")

