# Copy this file to .env and fill in keys only if you want the "Hosted" engine
# option to work (server-side key). Local (Ollama) and BYOK modes need nothing here.
# Never hard-code a real key anywhere else.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_BASE_URL=https://parley.api.mit.edu   # e.g. MIT Parley gateway keys (sk-parley-v1-...)
# HOSTED_ANTHROPIC_MODEL=claude-haiku-4-5         # chat/explanations (default: haiku — cheap)
# ANTHROPIC_VISION_MODEL=claude-sonnet-4-6        # structure recognition (default: sonnet — accurate)

# ── Production (ORGO_ENV=prod — see README "Production mode") ──────────────
# Auth: at least one of these is REQUIRED in prod; either also enables auth in dev.
# SUPABASE_URL=https://your-project-ref.supabase.co   # JWKS verification (projects since May 2025)
# SUPABASE_JWT_SECRET=...                             # legacy HS256 shared secret
# SUPABASE_JWKS_URL=...                               # explicit JWKS URL (overrides SUPABASE_URL-derived)
# HOSTED_DAILY_REQUESTS=200                           # per-user daily cap for Hosted engine mode

# Optional Ollama overrides (defaults shown):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b
# Vision model is auto-detected from installed models (qwen3-vl > qwen2.5vl >
# gemma3 > minicpm-v > llava > moondream > llama3.2-vision). Set to force one.
# Note: llama3.2-vision no longer loads on Ollama >= 0.30 (mllama dropped).
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
